{
    auto_https disable_redirects
}

http://correo.sa.com.gt, http://webmail.sa.com.gt, https://correo.sa.com.gt, https://webmail.sa.com.gt {
    encode gzip zstd
    reverse_proxy 127.0.0.1:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}

http://cuentas.sa.com.gt, https://cuentas.sa.com.gt {
    encode gzip zstd
    reverse_proxy 127.0.0.1:5000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}

http://panel.sa.com.gt, https://panel.sa.com.gt, http://whm.sa.com.gt, https://whm.sa.com.gt {
    encode gzip zstd
    reverse_proxy 127.0.0.1:9001 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}

http://sa.com.gt, http://www.sa.com.gt, http://donpollo.sa.com.gt, http://cdpe.sa.com.gt, :80 {
    encode gzip zstd
    @mail path /correo /correo/ /webmail /webmail/
    handle @mail {
        redir https://correo.sa.com.gt/ permanent
    }
    @cuentas path /cuentas /cuentas/
    handle @cuentas {
        redir https://cuentas.sa.com.gt/ permanent
    }
    handle {
        reverse_proxy 127.0.0.1:56990 {
            header_up Host localhost:56990
            header_up X-Forwarded-Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

https://sa.com.gt, https://www.sa.com.gt, https://donpollo.sa.com.gt, https://cdpe.sa.com.gt {
    encode gzip zstd
    @mail path /correo /correo/ /webmail /webmail/
    handle @mail {
        redir https://correo.sa.com.gt/ permanent
    }
    @cuentas path /cuentas /cuentas/
    handle @cuentas {
