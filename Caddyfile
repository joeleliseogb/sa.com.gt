http://gtcop.sa.com.gt, https://gtcop.sa.com.gt {
    encode gzip zstd

    handle /Backup/Backup {
        reverse_proxy 127.0.0.1:56992 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /Backup/Restore {
        reverse_proxy 127.0.0.1:56992 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    @movil_app path /app /app/* /movil /movil/*
    handle @movil_app {
        header Cache-Control "no-cache, must-revalidate"
        uri strip_prefix /app
        uri strip_prefix /movil
        root * C:/SimplyGest/ResumenEjecutivo/web/app
        file_server {
            index index.html
        }
    }

    @gtcop_theme_assets path /gtcop_theme/*
    handle @gtcop_theme_assets {
        header Cache-Control "no-cache, must-revalidate"
        uri strip_prefix /gtcop_theme
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme
        file_server
    }

    @asociados_images path /Images/Asociados/*
    handle @asociados_images {
        header Cache-Control "no-cache, must-revalidate"
        uri strip_prefix /Images/Asociados
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme/asociados
        file_server
    }

    @pwa_manifest path /manifest.webmanifest /manifest.json
    handle @pwa_manifest {
        header Content-Type "application/manifest+json"
        header Cache-Control "no-cache, must-revalidate"
        rewrite * /manifest.webmanifest
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme
        file_server
    }

    @pwa_sw path /service-worker.js /sw.js
    handle @pwa_sw {
        header Content-Type "application/javascript"
        header Cache-Control "no-cache, must-revalidate"
        header Service-Worker-Allowed "/"
        rewrite * /service-worker.js
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme
        file_server
    }

    @theme_bundles_modernizr path /bundles/modernizr*
    handle @theme_bundles_modernizr {
        header Content-Type "application/javascript"
        header Cache-Control "no-cache, must-revalidate"
        rewrite * /modernizr-2.8.3.js
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme
        file_server
    }

    @theme_css path /Content/Site.css
    handle @theme_css {
        header Cache-Control "no-cache, must-revalidate"
        rewrite * /Site.css
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme
        file_server
    }

    @theme_skin path /Content/AdminLTE/skins/skin-yellow.css
    handle @theme_skin {
        header Cache-Control "no-cache, must-revalidate"
        rewrite * /skin-yellow.css
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme
        file_server
    }

    @theme_js path /Scripts/modernizr-2.8.3.js
    handle @theme_js {
        header Cache-Control "no-cache, must-revalidate"
        rewrite * /modernizr-2.8.3.js
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme
        file_server
    }

    @theme_logo_horizontal path /Images/LogoIQHorizontal.png /Images/LogoIQSD.png
    handle @theme_logo_horizontal {
        header Cache-Control "no-cache, must-revalidate"
        rewrite * /logo_cdpe.png
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme
        file_server
    }

    @theme_logo_icon path /Images/logoSolo.png /Images/LogoIQHorizontalSmall.png
    handle @theme_logo_icon {
        header Cache-Control "no-cache, must-revalidate"
        rewrite * /logo_cdpe_icon.png
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme
        file_server
    }

    @theme_custom_images path /Images/logo_cdpe.png /Images/logo_cdpe_icon.png
    handle @theme_custom_images {
        header Cache-Control "no-cache, must-revalidate"
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme
        file_server
    }

    @theme_favicon path /favicon.ico /Images/favicon.ico
    handle @theme_favicon {
        header Cache-Control "no-cache, must-revalidate"
        rewrite * /favicon.ico
        root * C:/SimplyGest/ResumenEjecutivo/web/gtcop_theme
        file_server
    }

    handle {
        reverse_proxy 127.0.0.1:8082 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}